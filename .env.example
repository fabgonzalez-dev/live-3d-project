# Server environment variables
# Copy to .env and fill in values

# Port for the local Express/WebSocket server
SERVER_PORT=3001

# (Optional) TikTok Live Connector credentials — only needed for live TikTok events
# Leave blank to run in simulator mode
TIKTOK_USERNAME=
TIKTOK_SESSION_ID=

# WebSocket allowed origins (comma-separated, default: localhost only)
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
